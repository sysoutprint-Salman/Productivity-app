         <center>
            <ScrollPane fx:id="mainScrollpane" fitToHeight="true" fitToWidth="true" prefHeight="474.0" prefWidth="518.0" styleClass="tasks_scroll_pane" vbarPolicy="NEVER" BorderPane.alignment="CENTER">
               <content>
                   <VBox fx:id="mainTaskVbox" prefWidth="1029.0" spacing="10.0" styleClass="tasks_vbox" />
               </content>
            </ScrollPane>
         </center>
      </BorderPane>
      <Label fx:id="taskLabel" alignment="CENTER" layoutX="10.0" layoutY="60.0" prefHeight="35.0" prefWidth="600.0" styleClass="tasks_label" textAlignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
         <font>
            <Font size="24.0" />
         </font></Label>
      <MenuButton fx:id="sortButton" layoutX="1585.0" layoutY="90.0" mnemonicParsing="false" text="Sort" textFill="WHITE" AnchorPane.rightAnchor="282.20000000000005" AnchorPane.topAnchor="90.0">
        <items>
            <RadioMenuItem fx:id="A_Z" mnemonicParsing="false" text="A_Z" />
            <RadioMenuItem fx:id="Due_Date" mnemonicParsing="false" text="Due Date" />
            <RadioMenuItem fx:id="Newest" mnemonicParsing="false" text="Newest" />
        </items>
      </MenuButton>
      <MenuBar layoutX="10.0" layoutY="10.0" prefHeight="26.0" prefWidth="600.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <menus>
            <Menu text="To Do">
               <items>
                  <MenuItem onAction="#getByPosted" text="View Tasks" />
                  <MenuItem onAction="#getByDeleted" text="Deleted Tasks" />
                  <MenuItem onAction="#getByCompleted" text="Completed Tasks" />
                  <MenuItem text="Close" />
               </items>
               <graphic>
                  <ImageView styleClass="icon">
