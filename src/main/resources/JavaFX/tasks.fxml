                        <Image url="@../Images/check.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Menu>
            <Menu text="AI Chat">
               <items>
                  <MenuItem fx:id="gptMenuItem1" onAction="#switchToGPT" text="Chat with AI assistant" />
               </items>
               <graphic>
                  <ImageView styleClass="icon">
                     <image>
                        <Image url="@../Images/user.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Menu>
            <Menu text="Notebook">
               <items>
                  <MenuItem fx:id="viewNotebook2" onAction="#switchToNotebook" text="View Notebook" />
               </items>
               <graphic>
                  <ImageView styleClass="icon">
                     <image>
                        <Image url="@../Images/notepad.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Menu>
            <Menu text="Kanban">
