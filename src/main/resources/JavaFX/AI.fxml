<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="768.0" prefWidth="1366.0" styleClass="chatbox_stage" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ai_chat.AI_AssistantFX">
   <children>
       <fx:include fx:id="nav" source="navigation.fxml" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
       <BorderPane layoutX="72.8" layoutY="88.8" styleClass="main_pane" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="73.0" AnchorPane.rightAnchor="118.0" AnchorPane.topAnchor="89.0">
          <bottom>
              <HBox fx:id="messageAreaHbox" alignment="CENTER" styleClass="hbox_container" BorderPane.alignment="CENTER">
                  <children>
                      <HBox alignment="CENTER" maxWidth="900.0" prefHeight="52.0" prefWidth="781.0" styleClass="prompt_area">
                          <children>
                              <TextField fx:id="userTextField" promptText="Ask something to the AI assistant." styleClass="prompt_textfield" HBox.hgrow="ALWAYS" />

                              <Button fx:id="sendButton" mnemonicParsing="false" onAction="#onSendMessage" styleClass="send_button">
                                  <graphic>
                                      <ImageView fx:id="uploadIcon" styleClass="upload_icon">
                                          <image>
                                              <Image url="@../Images/up-arrow.png" />
                                          </image>
                                      </ImageView>
                                  </graphic>
                              </Button>
                          </children>
                          <padding>
                              <Insets bottom="4.0" left="12.0" right="6.0" top="4.0" />
                          </padding>
                      </HBox>
                  </children>
              </HBox>
          </bottom>
         <center>
            <ScrollPane fx:id="messageScrollPane" fitToWidth="true" pannable="true" prefHeight="473.0" prefWidth="1302.0" vbarPolicy="NEVER" BorderPane.alignment="CENTER">
              <content>
                  <VBox fx:id="chatBoxVbox" alignment="CENTER_LEFT" prefWidth="566.0" spacing="15.0" styleClass="chatbox">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding></VBox>
              </content>
            </ScrollPane>
         </center></BorderPane>
   </children>
   <stylesheets>
      <URL value="@../CSS/AI_Assistant.css" />
      <URL value="@../CSS/MenuBar.css" />
   </stylesheets>
</AnchorPane>
