<AnchorPane prefHeight="610.0" prefWidth="600.0" styleClass="main_stage" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JavaFX.NotebookFX">
    <MenuBar prefHeight="26.0" prefWidth="600.0" style="-fx-background-color: white;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <menus>
            <Menu mnemonicParsing="false" text="To Do">
                <items>
                    <MenuItem fx:id="mainTasks" mnemonicParsing="false" onAction="#switchToTasks" text="View Tasks" />
                    <MenuItem mnemonicParsing="false" text="Close" />
                </items>
            <graphic>
               <ImageView styleClass="check_icon">
                  <image>
                     <Image url="@../Images/check.png" />
                  </image>
               </ImageView>
            </graphic>
            </Menu>
            <Menu mnemonicParsing="false" text="AI Chat">
                <items>
                    <MenuItem fx:id="gptMenuItem" mnemonicParsing="false" onAction="#switchToGPT" text="Chat with AI assistant" />
                </items>
            <graphic>
               <ImageView styleClass="ai_icon">
                  <image>
                     <Image url="@../Images/user.png" />
                  </image>
               </ImageView>
            </graphic>
            </Menu>
         <Menu mnemonicParsing="false" text="Notebook">
           <items>
             <MenuItem fx:id="newTabsItem" mnemonicParsing="false" onAction="#createNewTab" text="New Tab" />
           </items>
            <graphic>
               <ImageView styleClass="notepad_icon">
                  <image>
                     <Image url="@../Images/notepad.png" />
                  </image>
               </ImageView>
            </graphic>
         </Menu>
        </menus>
    </MenuBar>
   <BorderPane layoutX="15.0" layoutY="47.2" prefHeight="549.0" prefWidth="570.0" styleClass="main_notebook" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="47.0">
      <left>
         <ScrollPane fx:id="tabsScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" pannable="true" prefHeight="350.0" prefWidth="169.0" BorderPane.alignment="CENTER">
            <content>
               <VBox styleClass="tabs_container">
                  <children>
                     <TitledPane animated="false" collapsible="false" contentDisplay="RIGHT" expanded="false" prefHeight="32.0" prefWidth="168.0" styleClass="tabs_header">
                       <content>
                         <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                       </content>
                        <VBox.margin>
                           <Insets />
                        </VBox.margin>
                        <graphic>
                           <HBox alignment="CENTER" prefHeight="31.0" prefWidth="147.0">
                              <children>
                                 <Label prefHeight="24.0" prefWidth="112.0" text="Tabs" textFill="WHITE">
                                    <padding>
                                       <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
                                    </padding>
                                    <font>
                                       <Font name="System Bold" size="14.0" />
                                    </font>
                                 </Label>
                                 <Button mnemonicParsing="false" onAction="#createNewTab">
                                    <graphic>
                                       <ImageView fitHeight="15.0" fitWidth="15.0" styleClass="add_icon">
                                          <image>
                                             <Image url="@../Images/plus%20(5).png" />
                                          </image>
                                       </ImageView>
                                    </graphic></Button>
                              </children>
                           </HBox>
                        </graphic>
                     </TitledPane>
                     <VBox fx:id="tabsVbox" prefHeight="72.0" prefWidth="168.0" styleClass="tabs_vbox" VBox.vgrow="ALWAYS" />
                  </children>
               </VBox>
            </content>
            <BorderPane.margin>
               <Insets right="10.0" />
            </BorderPane.margin>
         </ScrollPane>
      </left>
      <center>
         <ScrollPane fx:id="notebookScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" pannable="true" prefHeight="350.0" prefWidth="401.0" styleClass="notepad_scroll_pane" vbarPolicy="NEVER" BorderPane.alignment="CENTER">
            <content>
               <TextArea prefHeight="200.0" prefWidth="200.0" styleClass="notepad" visible="false" />
            </content></ScrollPane>
      </center>
   </BorderPane>
   <stylesheets>
      <URL value="@../CSS/Notebook.css" />
      <URL value="@../CSS/MenuBar.css" />
   </stylesheets>

</AnchorPane>
